# Template for the gitignored .env. Never add a real credential here.
#
# Caller credentials for the gateway (required; it refuses to start without
# them). Format: name:task[+task...]:key, entries separated by commas.
# Generate one with `make dev-key` rather than copying a value from here —
# there is deliberately no default key in this repository, because a committed
# development credential is a public one.
#
# AVOIDPP_API_KEYS=local-dev:translate_fi_en_v1:<43-character-generated-key>

# Rate limits, as rate/burst. Per gateway process, not cluster-wide.
AVOIDPP_RATE_CALLER=1/5
AVOIDPP_RATE_GLOBAL=2/10
AVOIDPP_RATE_UNAUTHENTICATED=2/10

# Admission control: concurrent inference calls, and how many may wait.
AVOIDPP_MAX_ACTIVE=4
AVOIDPP_MAX_QUEUED=8

# Gateway behaviour. See docs/configuration.md for the full list.
AVOIDPP_POLICY_MODE=monitoring
AVOIDPP_LOG_LEVEL=info
AVOIDPP_HOST_PORT=8099

# Detector mode. `fake` needs no provider credential and calls no paid API.
AVOIDPP_DETECTOR_MODE=fake

# Provider credential for live inference. Required only by the live-* targets,
# which spend money and are never run by CI or `make check`.
# LLM_API_KEY=sk-ant-...
