# Local configuration and credentials
.env
.env.*
!.env.example
*.pem
*.key
credentials.*
secrets.*

# Python environments, caches and build output
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
*.egg-info/

# Generated artifacts and machine-local files
bin/
build/
dist/
coverage/
*.test
*.prof
.DS_Store
.idea/
.vscode/

# Evaluation outputs and private input data
# Working evaluation runs are ignored. Note the trailing /* rather than /:
# git cannot re-include a file whose parent DIRECTORY is excluded, so
# excluding the contents is what makes the negation below work.
evals/reports/*
# Milestone reports are evidence, not working output - they pin a measurement
# to a dataset hash, a detector identity and a prompt version, which is the
# point of C06-AC2.
!evals/reports/milestones/
evals/datasets/private/
data/private/

# Local tooling and scratch work
.tools/
.workspace/
tmp/
